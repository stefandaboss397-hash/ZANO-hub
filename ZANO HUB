-- Function for creating buttons with names of egg/pet
local function createEggButton(name, posY, color, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 230, 0, 28)
    btn.Position = UDim2.new(0.5, -115, 0, posY)
    btn.BackgroundColor3 = color
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.TextSize = 11
    btn.Font = Enum.Font.SourceSansBold
    btn.Text = name
    btn.Parent = MainFrame
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 5)
    corner.Parent = btn
    
    btn.MouseButton1Click:Connect(callback)
end

-- Function for getting CHARACTER
local function getRootPart()
    local character = LocalPlayer.Character
    if character then
        return character:FindFirstChild("HumanoidRootPart")
    end
    return nil
end

-- Search function and teleport to an egg/pet specified by name
local function teleportToEggName(targetName)
    if not EggsFolder then return end
    local rootPart = getRootPart()
    if not rootPart then return end
    
    local foundEgg = nil
    for _, egg in ipairs(EggsFolder:GetChildren()) do
        -- Search by egg name or attributes if set
        if string.find(string.lower(egg.Name), string.lower(targetName)) then
            foundEgg = egg:IsA("Model") and egg.PrimaryPart or egg
            break
        end
    end
    
    if foundEgg and (foundEgg:IsA("BasePart") or foundEgg:IsA("Part")) then
        rootPart.CFrame = foundEgg.CFrame + Vector3.new(0, 3, 0)
        print("You teleported to: " .. targetName)
    else
        warn("Egg '" .. targetName .. "' is currently not found on the map.")
    end
end

